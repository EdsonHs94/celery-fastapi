# Credenciales exclusivas del laboratorio local.
POSTGRES_USER=reports
POSTGRES_PASSWORD=reports-db-local-only
POSTGRES_DB=reports
RABBITMQ_DEFAULT_USER=reports
RABBITMQ_DEFAULT_PASS=reports-broker-local-only
RABBITMQ_DEFAULT_VHOST=reports

# Nombres de servicios de Compose; no se resuelven desde Python en el host.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
BROKER_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/${RABBITMQ_DEFAULT_VHOST}
REPORTS_DIR=/app/reports
SIMULATE_TRANSIENT_FAILURE=true

API_PORT=8000
RABBITMQ_MANAGEMENT_PORT=15672
